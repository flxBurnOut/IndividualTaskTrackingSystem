# Publish only the software tree; local data and reports stay on this machine.
/*
!/.gitignore
!/README.md
!/AGENTS.md
!/pyproject.toml
!/启动个人事务管理Beta.vbs
!/src/
!/tests/
!/packaging/
!/docs/

# Public documentation only.
/docs/*
!/docs/使用说明.md
!/docs/Beta开发与验收.md
!/docs/开发交接与当前状态.md
!/docs/手动优先与多助手接入方案.md
!/docs/开发与扩展.md
!/docs/Codex接口与后台推理.md
!/docs/固定会话与原文件目录.md
!/docs/新手引导.md
!/docs/发布说明_1.0.0.md
!/docs/发布说明_1.0.1.md
!/docs/发布说明_1.0.2.md
!/docs/发布说明_1.1.0.md
!/docs/发布说明_1.1.1.md
!/docs/发布说明_1.2.0.md
!/docs/发布说明_1.2.1.md

# Required build inputs and reusable package verification.
/packaging/*
!/packaging/build.py
!/packaging/entry.py
!/packaging/personal_management.spec
!/packaging/render_icon.py
!/packaging/version_info.py
!/packaging/smoke.py
!/packaging/upgrade_smoke.py
!/packaging/tray_smoke.py
!/packaging/workflow.py
!/packaging/check.py
!/packaging/maintenance.py
!/packaging/publish.py
!/packaging/codex_entry.py
!/packaging/installer.iss
!/packaging/build_installer.py
!/packaging/license_notices.py

# Private data, credentials, local settings and generated files anywhere.
/.beta-data/
/data/
.venv/
__pycache__/
*.py[cod]
.pytest_cache/
*.egg-info/
.codex/
.agents/
.env
.env.*
*.db
*.db-*
*.db.*
*.sqlite
*.sqlite-*
*.sqlite.*
*.sqlite3
*.sqlite3-*
*.sqlite3.*
*.log
*.tmp
*.bak
*.pem
*.key
*.p12
*.pfx
auth.json
runtime.json
ui-onboarding.json
.ui-onboarding-*.tmp
ui-plan-drafts/
config.local.*
settings.local.*
.DS_Store
Thumbs.db
