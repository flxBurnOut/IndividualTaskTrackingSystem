# Publish only the software tree; local data and reports stay on this machine.
/*
!/.gitignore
!/README.md
!/pyproject.toml
!/启动个人事务管理.vbs
!/src/
!/tests/
!/packaging/
!/docs/

# Public documentation only.
/docs/*
!/docs/使用说明.md
!/docs/开发与扩展.md
!/docs/Codex接口与后台推理.md
!/docs/固定会话与原文件目录.md

# Required build inputs and reusable package verification.
/packaging/*
!/packaging/build.py
!/packaging/entry.py
!/packaging/personal_management.spec
!/packaging/render_icon.py
!/packaging/version_info.py
!/packaging/smoke.py

# Private data, credentials, local settings and generated files anywhere.
.venv/
__pycache__/
*.py[cod]
.pytest_cache/
*.egg-info/
.codex/
.agents/
.env
.env.*
*.db
*.db-*
*.sqlite
*.sqlite-*
*.sqlite3
*.sqlite3-*
*.log
*.tmp
*.bak
*.pem
*.key
*.p12
*.pfx
auth.json
runtime.json
config.local.*
settings.local.*
.DS_Store
Thumbs.db
